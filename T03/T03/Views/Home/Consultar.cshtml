@model List<T03.Models.ConsultarAbonoModel>

@{
    Layout = "_LayoutExterno";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="d-flex justify-content-start">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-gradient-danger btn-rounded btn-fw">

                <i class="mdi mdi-arrow-left"></i>
                Ir a Inicio

            </a>

        </div>
    </div>
</div>


<div class="row">

    <div class="col-lg-12 grid-margin stretch-card">

        <div class="card bg-gradient-success card-img-holder shadow-lg">

            <div class="card-body">

                <img src="~/image/circle.svg"
                     class="card-img-absolute"
                     alt="circle-image" />

                <h4 class="card-title text-center text-white mb-4">
                    Consulta de Compras
                </h4>

                <div class="table-responsive">

                    <table class="table text-center">

                        <thead>
                            <tr>
                                <th>Código Compra</th>
                                <th>Descripción</th>
                                <th>Precio</th>
                                <th>Saldo</th>
                                <th>Estado</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model != null && Model.Any())
                            {
                                foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            @item.IdCompra
                                        </td>

                                        <td>
                                            @item.Descripcion
                                        </td>

                                        <td>
                                            ₡@item.Precio.ToString("N2")
                                        </td>

                                        <td>
                                            ₡@item.Saldo.ToString("N2")
                                        </td>

                                        <td>
                                            @if (@item.Estado == "Pendiente")
                                            {
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Cancelado</span>
                                            }
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5">
                                        No hay compras registradas
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>

    </div>

</div>